{
	// https://nuxt.com/docs/guide/concepts/typescript
	"extends": "./.nuxt/tsconfig.json",
	"compilerOptions": {
		"strict": false,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["vitest/globals", "node"],
		"paths": {
			"@/*": ["./app/*"],
			"~/*": ["./app/*"],
			"@@/*": ["./*"],
			"~~/*": ["./*"]
		}
	},
	"include": [
		"nuxt.config.ts",
		"app/**/*",
		"src/**/*",
		"server/**/*",
		"tests/**/*",
		"shared/**/*",
		".nuxt/nuxt.d.ts",
		".nuxt/nuxt.node.d.ts"
	],
	"vueCompilerOptions": {
		"plugins": []
	}
}
