{
	"name": "patrolli-frontend",
	"version": "0.0.0-dev",
	"license": "AGPL-3.0-only",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "26",
		"pnpm": ">=12"
	},
	"save-exact": true,
	"scripts": {
		"dev": "nuxt dev --open",
		"build": "nuxt build",
		"build:dev": "nuxt build",
		"build:prod": "nuxt build",
		"preview": "node .output/server/index.mjs",
		"build-only": "nuxt build",
		"postinstall": "nuxt prepare",
		"type-check": "vue-tsc --noEmit",
		"lint": "pnpm lint:js && pnpm lint:prettier",
		"lint:cache-fix": "eslint --cache --fix",
		"lint:js": "eslint --ext \".js,.ts,.vue\"  --ignore-pattern=.gitignore,.eslintignore .",
		"lintfix:js": "pnpm lint:js --fix",
		"lint:prettier": "prettier --check .",
		"lintfix:prettier": "prettier --write --list-different .",
		"api:schema-dev": "orval --project devschema",
		"api:schema-patrolli": "orval --project patrolliapischema",
		"api:schema": "pnpm schema:get && orval --project apischema",
		"schema:get": "curl --insecure http://localhost:8080/api-docs/openapi.json -o openapi.json",
		"dependencies-refresh": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"depr": "pnpm dependencies-refresh",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:unit": "vitest run tests/unit",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:full": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@dagrejs/dagre": "3.0.0",
		"@iconify-json/lucide": "1.2.147",
		"@iconify-json/mdi": "1.2.3",
		"@iconify/vue": "5.0.4",
		"@pinia/nuxt": "1.0.2",
		"@tanstack/vue-form": "1.33.5",
		"@vue-flow/background": "1.3.2",
		"@vue-flow/controls": "1.1.3",
		"@vue-flow/core": "1.48.2",
		"@vueuse/core": "10.11.1",
		"axios": "1.20.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"echarts": "6.1.0",
		"monaco-editor": "0.55.1",
		"nuxt": "4.6.4",
		"pinia": "4.0.3",
		"pinia-plugin-persistedstate": "4.7.1",
		"reka-ui": "2.11.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "3.4.0",
		"tailwindcss-animate": "1.0.7",
		"uuid": "14.0.3",
		"vue": "3.5.43",
		"vue-echarts": "8.0.1",
		"vue-router": "4.5.0",
		"vue-sonner": "2.0.9",
		"vue3-json-viewer": "2.4.1",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@pinia/testing": "2.0.1",
		"@playwright/test": "1.64.1",
		"@rushstack/eslint-patch": "1.3.3",
		"@types/node": "26.6.5",
		"@vitejs/plugin-vue": "6.0.7",
		"@vitejs/plugin-vue-jsx": "4.2.0",
		"@vitest/ui": "4.1.12",
		"@vue/eslint-config-prettier": "8.0.0",
		"@vue/eslint-config-typescript": "12.0.0",
		"@vue/test-utils": "2.4.6",
		"autoprefixer": "10.4.19",
		"eslint": "8.49.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"eslint-plugin-vue": "9.17.0",
		"fast-uri": "3.1.9",
		"happy-dom": "21.0.4",
		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"orval": "8.27.0",
		"postcss": "8.5.27",
		"prettier": "3.8.3",
		"sass": "1.89.2",
		"shadcn-nuxt": "2.8.2",
		"typescript": "6.0.3",
		"vite": "6.4.6",
		"vitest": "4.1.12",
		"vue-tsc": "3.3.2"
	},
	"lint-staged": {
		"*/**/*.{js,jsx,ts,tsx,vue}": [
			"pnpm lintfix:js",
			"pnpm lintfix:prettier"
		],
		"*/**/*.{css,scss,json,md}": [
			"pnpm lintfix:prettier"
		]
	}
}
