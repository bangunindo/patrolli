{
	"name": "patrolli-frontend",
	"version": "0.0.0-dev",
	"license": "AGPL-3.0-only",
	"type": "module",
	"private": true,
	"save-exact": true,
	"scripts": {
		"dev": "nuxt dev --open",
		"build": "nuxt build",
		"build:dev": "nuxt build",
		"build:prod": "nuxt build",
		"preview": "node .output/server/index.mjs",
		"build-only": "nuxt build",
		"postinstall": "nuxt prepare",
		"type-check": "vue-tsc --noEmit",
		"lint": "npm run lint:js && npm run lint:prettier",
		"lint:cache-fix": "eslint --cache --fix",
		"lint:js": "eslint --ext \".js,.ts,.vue\"  --ignore-pattern=.gitignore,.eslintignore .",
		"lintfix:js": "npm run lint:js -- --fix",
		"lint:prettier": "prettier --check .",
		"lintfix:prettier": "prettier --write --list-different .",
		"api:schema-dev": "orval --project devschema",
		"api:schema-patrolli": "orval --project patrolliapischema",
		"api:schema": "npm run schema:get && orval --project apischema",
		"schema:get": "curl --insecure http://localhost:8080/api-docs/openapi.json -o openapi.json",
		"dependencies-refresh": "rm -rf node_modules package-lock.json && npm install",
		"depr": "npm run dependencies-refresh",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:unit": "vitest run tests/unit"
	},
	"dependencies": {
		"@dagrejs/dagre": "3.0.0",
		"@iconify-json/lucide": "1.2.147",
		"@iconify-json/mdi": "1.2.3",
		"@iconify/vue": "5.0.4",
		"@jsonforms/core": "^3.8.0",
		"@jsonforms/vue": "^3.8.0",
		"@pinia/nuxt": "1.0.2",
		"@vue-flow/background": "1.3.2",
		"@vue-flow/controls": "1.1.3",
		"@vue-flow/core": "1.48.2",
		"@vueuse/core": "^10.11.1",
		"axios": "1.20.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"echarts": "6.1.0",
		"jwt-decode": "4.0.0",
		"monaco-editor": "0.55.1",
		"nuxt": "4.6.2",
		"pinia": "4.0.3",
		"pinia-plugin-persistedstate": "4.7.1",
		"reka-ui": "^2.11.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "3.4.0",
		"tailwindcss-animate": "1.0.7",
		"uuid": "14.0.3",
		"vue": "3.5.43",
		"vue-echarts": "8.0.1",
		"vue-router": "4.5.0",
		"vue-sonner": "^2.0.9",
		"vue3-json-viewer": "2.4.1",
		"yaml": "^2.7.0",
		"zod": "3.25.76",
		"zod-to-json-schema": "3.25.2"
	},
	"devDependencies": {
		"@pinia/testing": "2.0.1",
		"@rushstack/eslint-patch": "1.3.3",
		"@types/node": "26.6.5",
		"@vitejs/plugin-vue": "6.0.7",
		"@vitejs/plugin-vue-jsx": "4.2.0",
		"@vitest/ui": "4.1.11",
		"@vue/eslint-config-prettier": "8.0.0",
		"@vue/eslint-config-typescript": "12.0.0",
		"@vue/test-utils": "2.4.6",
		"autoprefixer": "10.4.19",
		"eslint": "8.49.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"eslint-plugin-vue": "9.17.0",
		"fast-uri": "3.1.9",
		"happy-dom": "21.0.4",
		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"orval": "8.27.0",
		"postcss": "8.5.27",
		"prettier": "3.8.3",
		"sass": "1.89.2",
		"shadcn-nuxt": "^2.8.2",
		"typescript": "6.0.3",
		"vite": "6.4.4",
		"vitest": "4.1.11",
		"vue-tsc": "3.3.2"
	},
	"overrides": {
		"minimatch": "9.0.7",
		"esbuild": "0.25.0",
		"form-data": "4.0.6",
		"js-yaml": "4.3.2",
		"dompurify": "3.4.16",
		"postcss": "8.5.27",
		"devalue": "5.9.4",
		"source-map-js": "1.2.2",
		"braces": "3.0.3",
		"chokidar": "4.0.3",
		"micromatch": "4.0.8",
		"fast-glob": "3.3.3",
		"@simple-git/argv-parser": "2.0.1",
		"simple-git": "4.0.2",
		"node-forge": "1.4.0",
		"postcss-selector-parser": "7.1.6",
		"@vue/server-renderer": "3.5.43",
		"markdown-it": "14.3.3",
		"serialize-javascript": "7.1.4"
	},
	"pnpm": {
		"overrides": {
			"minimatch": "9.0.7",
			"esbuild": "0.25.0",
			"form-data": "4.0.6",
			"js-yaml": "4.3.2",
			"dompurify": "3.4.16",
			"postcss": "8.5.27",
			"devalue": "5.9.4",
			"source-map-js": "1.2.2",
			"braces": "3.0.3",
			"chokidar": "4.0.3",
			"micromatch": "4.0.8",
			"fast-glob": "3.3.3",
			"@simple-git/argv-parser": "2.0.1",
			"simple-git": "4.0.2",
			"node-forge": "1.4.0",
			"postcss-selector-parser": "7.1.6",
			"@vue/server-renderer": "3.5.43"
		},
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild",
			"vue-demi"
		]
	},
	"lint-staged": {
		"*/**/*.{js,jsx,ts,tsx,vue}": [
			"npm run lintfix:js",
			"npm run lintfix:prettier"
		],
		"*/**/*.{css,scss,json,md}": [
			"npm run lintfix:prettier"
		]
	},
	"allowScripts": {
		"vue-demi@0.14.10": true,
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.25.0": true
	}
}
